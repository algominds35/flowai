# ============================================================
# RAILWAY ENVIRONMENT VARIABLES — paste these into Railway dashboard
# ============================================================

# Database — Railway auto-sets this when you add a PostgreSQL plugin
DATABASE_URL=postgresql://user:pass@host:5432/railway

# Security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Your Vercel frontend URL (set after deploying frontend)
FRONTEND_URL=https://your-app.vercel.app

# ============================================================
# OPTIONAL — Integration API keys (leave blank to use fixture data)
# ============================================================

# Plaid — https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# QuickBooks — https://developer.intuit.com/app/developer/qbo/docs/get-started
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=https://your-api.railway.app/api/v1/integrations/qbo/callback
QBO_ENVIRONMENT=sandbox

# Shopify — https://partners.shopify.com/
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_REDIRECT_URI=https://your-api.railway.app/api/v1/integrations/shopify/callback

# Amazon SP-API — https://sellercentral.amazon.com/developer-console
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
